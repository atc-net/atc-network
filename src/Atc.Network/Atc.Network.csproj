<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Atc.Network</PackageId>
    <PackageTags>network;tcp;udp;tls;socket;client;server;reconnect;keep-alive;framing;ipv6;opentelemetry;metrics;ip-scanner;port-scanner;ping;arp;mac-vendor;vnc;rfb</PackageTags>
    <Description>TCP and UDP clients and servers for .NET with TLS, auto-reconnect, keep-alive, message framing, IPv6 and dual-mode servers, plus an IP and port scanner (ping, host name, MAC vendor) and a VNC (RFB) client. Built for ILogger and IHostedService, with OpenTelemetry metrics and traces.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Atc.Network.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Atc" Version="4.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resource\Communication.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Communication.resx</DependentUpon>
    </Compile>
    <Compile Update="Resource\EnumResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>EnumResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resource\Communication.da-DK.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resource\Communication.de-DE.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resource\Communication.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Communication.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resource\EnumResources.da-DK.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resource\EnumResources.de-DE.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resource\EnumResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>EnumResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
